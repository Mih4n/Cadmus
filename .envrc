#!/usr/bin/env bash
# direnv: entering the directory activates the devenv shell, so `dotnet run` always sees GLFW,
# the Vulkan loader and the validation layers. Run `direnv allow` once to enable it.
source_url "https://raw.githubusercontent.com/cachix/devenv/82c0147677e510b247d8b9165c54f73d32dfd899/direnvrc" "sha256-7u4iDd1nZpxL4tCzmPG0dQgC5V+/44Ba+tHkPob1v2k="

use devenv
